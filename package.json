{
    "author": "ChrisOfNormandy",
    "description": "A collection of styles to make routine designs simpler.",
    "license": "MIT",
    "name": "@dead-harbour/scss-rigging",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "1.0.7",
    "files": [
        "scss",
        "dist"
    ],
    "exports": {
        "./*": "./scss/*",
        "./config": {
            "import": "./dist/config.js",
            "require": "./dist/config.js",
            "types": "./dist/config.d.ts"
        },
        "./themes": {
            "import": "./dist/ThemeOptions.js",
            "require": "./dist/ThemeOptions.js",
            "types": "./dist/ThemeOptions.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "require": "./dist/types.js",
            "types": "./dist/types.d.ts"
        }
    },
    "dependencies": {
        "sass": "^1.104.0"
    },
    "devDependencies": {
        "@dead-harbour/shipshape": "1.0.7",
        "@stylistic/stylelint-config": "^5.0.0",
        "@stylistic/stylelint-plugin": "^5.3.0",
        "@types/node": "^26.4.1",
        "knip": "^6.34.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.28",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-scss": "^7.2.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "sass": ">=1.100"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "oxlint . --fix; oxfmt; yarn stylelint '**/*.scss'",
        "sanity": "yarn typecheck && yarn lint && yarn knip",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}